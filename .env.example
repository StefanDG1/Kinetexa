# Copy to a git-ignored .env.local. Leave secret values out of source control.
# Separate credentials and datasets are required for development and production.

# Web and identity
KINETEXA_APP_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=

# Application backend
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Private raw activity storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Billing: development must use Stripe test resources
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
KINETEXA_PAYMENTS_ENABLED=false

# Transactional mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Optional telemetry: disabled until configured and user consent is recorded
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
KINETEXA_TELEMETRY_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_SECRET_KEY=

# AI: service configuration alone does not grant user consent
AI_GATEWAY_API_KEY=
KINETEXA_AI_MODEL=

# Mapping: choose a licensed production tile source
NEXT_PUBLIC_MAP_STYLE_URL=

# Hosted deletion ledger: separate private backup bucket. Development can opt out explicitly.
KINETEXA_ENVIRONMENT=development
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
