{
  "name": "kinetexa",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @kinetexa/web",
    "build": "npm run build --workspace @kinetexa/web",
    "start": "npm run start --workspace @kinetexa/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "convex": "1.45.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.0"
  }
}
